NODE_ENV=development
PORT=4000

# postgresql://user:password@localhost:5432/giglink
DATABASE_URL=

# secrets for access/refresh tokens (openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# URL of the React app, for CORS + links in emails
CLIENT_URL=http://localhost:5173

# transactional email (verification, contact request notifications)
MAIL_FROM=no-reply@giglink.app
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# S3-compatible media storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
