generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  MUSICIAN
  RECRUITER
  ADMIN
}

// Discriminator for the extensible "profile" model. V1 only ever created
// MUSICIAN profiles; DJ was added in V2 by adding a new enum value + a new
// 1-1 extension table (see DjProfile below), without touching
// Venue/Certification/ContactRequest/Review/MediaItem. DANCER/LIGHTING_TECH
// can be added the same way later.
enum ProfileType {
  MUSICIAN
  DJ
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO_LINK
  EXTERNAL_LINK
}

enum MediaProvider {
  UPLOAD
  SPOTIFY
  YOUTUBE
  SOUNDCLOUD
  INSTAGRAM
  OTHER
}

enum CertificationStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ConsentType {
  TERMS
  PUBLIC_PROFILE
  CONTACT_SHARING
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  role            UserRole
  phone           String? // never exposed publicly, only via ContactDisclosure
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile                 Profile? // present when role = MUSICIAN (V2: also DJ/DANCER/...)
  venuesOwned             Venue[]                  @relation("VenueContact")
  contactRequestsSent     ContactRequest[]         @relation("RecruiterRequests")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  consents                Consent[]
  contactAccessLogs       ContactAccessLog[]       @relation("ContactAccessViewer")
  messagesSent            Message[]                @relation("MessageSender")
  events                  Event[]                  @relation("UserEvents")

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// RGPD: explicit, timestamped consent trail (public profile display,
// sharing contact details), kept even if the user later revokes it.
model Consent {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean
  ipAddress String?
  createdAt DateTime    @default(now())

  @@map("consents")
}

// ---------------------------------------------------------------------------
// Profiles (extensible by profile type)
// ---------------------------------------------------------------------------

// Generic "performer" profile shared by every profile type. Search, media,
// availability, certifications, reviews and contact requests all point here
// rather than at MusicianProfile directly, so V2 profile types plug in by
// adding a new extension table + enum value only.
model Profile {
  id               String        @id @default(uuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileType      ProfileType
  isGroup          Boolean       @default(false) // true = groupe/formation, false = artiste solo
  displayName      String
  bio              String?
  city             String?
  mobilityRadiusKm Int?
  rateMin          Int?
  rateMax          Int?
  rateCurrency     String        @default("EUR")
  status           ProfileStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  musicianProfile MusicianProfile?
  djProfile       DjProfile?
  media           MediaItem[]
  availabilities  Availability[]
  certifications  Certification[]
  contactRequests ContactRequest[] @relation("MusicianRequests")
  events          Event[]          @relation("ProfileEvents")

  @@map("profiles")
}

enum EventKind {
  ARTIST // un artiste qui joue (live de rue, concert)
  VENUE // un événement proposé par un établissement
}

// Événement géolocalisé et daté : posté par un artiste (kind ARTIST) ou par un
// établissement (kind VENUE). Visible sur la carte/agenda tant que endsAt > maintenant.
model Event {
  id          String    @id @default(uuid())
  ownerUserId String
  owner       User      @relation("UserEvents", fields: [ownerUserId], references: [id], onDelete: Cascade)
  profileId   String? // pour les lives d'artistes : lien vers le profil public
  profile     Profile?  @relation("ProfileEvents", fields: [profileId], references: [id], onDelete: SetNull)
  kind        EventKind
  title       String
  note        String?
  lat         Float
  lng         Float
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime  @default(now())

  @@index([startsAt])
  @@index([endsAt])
  @@map("events")
}

// 1-1 extension of Profile, only present when profileType = MUSICIAN.
// V2 adds DjProfile / DancerProfile / LightingTechProfile the same way.
model MusicianProfile {
  profileId String  @id
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  styles      MusicianStyle[]
  instruments MusicianInstrument[]

  @@map("musician_profiles")
}

// 1-1 extension of Profile, only present when profileType = DJ. Mirrors
// MusicianProfile's pattern: shares the same MusicalStyle taxonomy (genres),
// plus a free-text field for gear/setup since a fixed equipment list would
// go stale fast.
model DjProfile {
  profileId      String  @id
  profile        Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  equipmentNotes String?

  styles DjStyle[]

  @@map("dj_profiles")
}

model MusicalStyle {
  id   String @id @default(uuid())
  name String @unique

  musicians MusicianStyle[]
  djs       DjStyle[]

  @@map("musical_styles")
}

model DjStyle {
  djProfileId String
  djProfile   DjProfile    @relation(fields: [djProfileId], references: [profileId], onDelete: Cascade)
  styleId     String
  style       MusicalStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([djProfileId, styleId])
  @@map("dj_styles")
}

model MusicianStyle {
  musicianProfileId String
  musicianProfile   MusicianProfile @relation(fields: [musicianProfileId], references: [profileId], onDelete: Cascade)
  styleId           String
  style             MusicalStyle    @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([musicianProfileId, styleId])
  @@map("musician_styles")
}

model Instrument {
  id   String @id @default(uuid())
  name String @unique

  musicians MusicianInstrument[]

  @@map("instruments")
}

model MusicianInstrument {
  musicianProfileId String
  musicianProfile   MusicianProfile @relation(fields: [musicianProfileId], references: [profileId], onDelete: Cascade)
  instrumentId      String
  instrument        Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@id([musicianProfileId, instrumentId])
  @@map("musician_instruments")
}

model Availability {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("availabilities")
}

model MediaItem {
  id        String        @id @default(uuid())
  profileId String
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      MediaType
  provider  MediaProvider @default(UPLOAD)
  url       String
  isCover   Boolean       @default(false)
  position  Int           @default(0)
  createdAt DateTime      @default(now())

  @@map("media_items")
}

// ---------------------------------------------------------------------------
// Venues & certifications
// ---------------------------------------------------------------------------

model Venue {
  id            String   @id @default(uuid())
  name          String
  address       String?
  city          String?
  description   String?
  contactUserId String
  contactUser   User     @relation("VenueContact", fields: [contactUserId], references: [id])
  createdAt     DateTime @default(now())

  certifications Certification[]

  @@map("venues")
}

// Anti-abuse flow: the musician creates a PENDING row with a unique
// inviteToken and sends it to the venue. Nothing is public until an
// authenticated recruiter user linked to that venue opens the link and
// confirms, which sets venueId + status = CONFIRMED. claimedVenueName lets
// the UI show "awaiting confirmation from X" before the venue has an
// account of its own.
model Certification {
  id                String              @id @default(uuid())
  profileId         String
  profile           Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  venueId           String?
  venue             Venue?              @relation(fields: [venueId], references: [id])
  claimedVenueName  String?
  inviteToken       String              @unique
  performanceDate   DateTime?           @db.Date
  status            CertificationStatus @default(PENDING)
  confirmedAt       DateTime?
  confirmedByUserId String?
  expiresAt         DateTime?
  createdAt         DateTime            @default(now())

  review Review?

  @@map("certifications")
}

// One review per confirmed certification, left by the venue.
model Review {
  id              String        @id @default(uuid())
  certificationId String        @unique
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  rating          Int
  comment         String?
  createdAt       DateTime      @default(now())

  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Contact / messaging
// ---------------------------------------------------------------------------

model ContactRequest {
  id          String               @id @default(uuid())
  recruiterId String
  recruiter   User                 @relation("RecruiterRequests", fields: [recruiterId], references: [id])
  profileId   String
  profile     Profile              @relation("MusicianRequests", fields: [profileId], references: [id])
  message     String
  status      ContactRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  respondedAt DateTime?

  disclosures ContactDisclosure[]
  messages    Message[]

  @@map("contact_requests")
}

// Messagerie : conversation liée à une demande de contact acceptée.
// Les deux parties (recruteur + musicien) peuvent échanger.
model Message {
  id               String         @id @default(uuid())
  contactRequestId String
  contactRequest   ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  senderUserId     String
  sender           User           @relation("MessageSender", fields: [senderUserId], references: [id])
  body             String
  createdAt        DateTime       @default(now())
  readAt           DateTime?

  @@index([contactRequestId])
  @@map("messages")
}

// RGPD traceability: records exactly which field (phone/email) was
// disclosed to the recruiter and when, once the musician accepts.
model ContactDisclosure {
  id               String         @id @default(uuid())
  contactRequestId String
  contactRequest   ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  disclosedField   String
  disclosedAt      DateTime       @default(now())

  @@map("contact_disclosures")
}

// RGPD access log: records each time a recruiter actually views a
// musician's disclosed contact details (who, which request, when, from where).
model ContactAccessLog {
  id               String   @id @default(uuid())
  contactRequestId String
  viewerUserId     String
  viewer           User     @relation("ContactAccessViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  ipAddress        String?
  accessedAt       DateTime @default(now())

  @@index([contactRequestId])
  @@index([viewerUserId])
  @@map("contact_access_logs")
}
